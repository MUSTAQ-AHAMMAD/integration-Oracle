# Oracle Database Configuration
# Copy this file to .env and update with your values

# Oracle System Configuration
ORACLE_SID=XE
ORACLE_PDB=XEPDB1
ORACLE_PWD=Oracle123
ORACLE_CHARACTERSET=AL32UTF8

# Application User Configuration
DB_USER=ODOO_INTEGRATION
DB_PASSWORD=Oracle123
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=XE

# Connection String Format
# JDBC: jdbc:oracle:thin:@${DB_HOST}:${DB_PORT}:${ORACLE_SID}
# OR for PDB: jdbc:oracle:thin:@${DB_HOST}:${DB_PORT}/${ORACLE_PDB}
# TNS: ${DB_USER}/${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_SERVICE_NAME}

# Optional: Enable SQL*Plus Command Line
ENABLE_SQLPLUS=true

# Optional: Database Backup Configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
