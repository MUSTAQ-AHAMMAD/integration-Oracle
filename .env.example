# Oracle Integration Platform Configuration
# Copy this file to .env and update with your values

# ============================================
# Oracle Database Configuration
# ============================================
ORACLE_SID=XE
ORACLE_PDB=XEPDB1
ORACLE_PWD=Oracle123
ORACLE_CHARACTERSET=AL32UTF8
DB_PASSWORD=Oracle123

# ============================================
# Oracle CRM Configuration
# ============================================
CRM_PORT=3000
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars
LOG_LEVEL=info
RATE_LIMIT_MAX=150
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# Java Middleware Configuration
# ============================================
JDBC_URL=jdbc:oracle:thin:@oracle-db:1521:XE
JDBC_USER=ODOO_INTEGRATION
JDBC_PASSWORD=Oracle123

# ============================================
# Integration Settings
# ============================================
# VendHQ Configuration
VENDHQ_DOMAIN=
VENDHQ_TOKEN=
VENDHQ_REGION=

# Fusion Configuration
FUSION_HOST=
FUSION_USERNAME=
FUSION_PASSWORD=

# ============================================
# Backup & Maintenance
# ============================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7

# ============================================
# Development Settings
# ============================================
COMPOSE_PROJECT_NAME=oracle-integration
