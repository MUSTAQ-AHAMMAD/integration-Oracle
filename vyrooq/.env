# Vyrooq Environment Configuration
# Copy this file to .env and update with your credentials

# ============================================================================
# INFRASTRUCTURE
# ============================================================================

# Database
DATABASE_URL=postgresql://postgres:vyrooq123@localhost:5432/vyrooq

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://vyrooq:vyrooq123@localhost:5672

# Kafka
KAFKA_BROKERS=localhost:9092

# Temporal
TEMPORAL_HOST=localhost:7233

# ============================================================================
# ORACLE FUSION ERP
# ============================================================================

FUSION_BASE_URL=https://your-instance.fa.your-region.oraclecloud.com
FUSION_USERNAME=your-fusion-username
FUSION_PASSWORD=your-fusion-password
FUSION_HOSTNAME=your-instance
FUSION_REGION=your-region

# ============================================================================
# VENDHQ POS
# ============================================================================

VENDHQ_API_URL=https://yourdomain.vendhq.com/api/2.0
VENDHQ_API_TOKEN=your-vendhq-api-token

# ============================================================================
# OPENCART E-COMMERCE
# ============================================================================

OPENCART_API_URL=https://your-opencart-domain.com/api
OPENCART_API_KEY=your-opencart-api-key

# ============================================================================
# SECURITY
# ============================================================================

# JWT Secret (change in production!)
JWT_SECRET=your-secret-key-change-this-in-production-use-long-random-string

# JWT Expiration
JWT_EXPIRES_IN=24h

# ============================================================================
# APPLICATION
# ============================================================================

# Environment
NODE_ENV=development
PYTHON_ENV=development

# Server
PORT=3000
HOST=localhost

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# ============================================================================
# PROCESSING CONFIGURATION
# ============================================================================

# Maximum retry attempts
MAX_RETRY_ATTEMPTS=50

# Retry backoff (seconds)
RETRY_BACKOFF_SECONDS=60

# Worker concurrency
MAX_CONCURRENT_ACTIVITIES=100

# Batch size
BATCH_SIZE=100

# ============================================================================
# OBSERVABILITY
# ============================================================================

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=vyrooq

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=vyrooq123

# ============================================================================
# NEW SERVICES (Production Ready)
# ============================================================================

# Auth Service
AUTH_SERVICE_PORT=3100

# Retry Engine
RETRY_ENGINE_PORT=3200

# Deduplication Engine
DEDUPLICATION_ENGINE_PORT=3300

# Manual Control Engine
MANUAL_CONTROL_ENGINE_PORT=3400

# Reconciliation Engine
RECONCILIATION_ENGINE_PORT=3500

# Audit Engine
AUDIT_ENGINE_PORT=3600

# Event Bus
EVENT_BUS_PORT=3700

# Admin Dashboard
ADMIN_DASHBOARD_PORT=4000
SESSION_SECRET=change-this-to-a-strong-random-string-in-production

# Adapters
VENDHQ_ADAPTER_PORT=8100
OPENCART_ADAPTER_PORT=8200
FUSION_ADAPTER_PORT=8300

# ============================================================================
# PRODUCTION SECURITY (MUST CHANGE)
# ============================================================================

# IMPORTANT: Change these values in production!
# Use strong random strings for secrets
# Example: openssl rand -base64 64

# Session Secret (min 32 characters)
SESSION_SECRET_PRODUCTION=CHANGE_ME_TO_A_STRONG_RANDOM_STRING

# JWT Secret (min 64 characters)
JWT_SECRET_PRODUCTION=CHANGE_ME_TO_A_STRONG_RANDOM_STRING

# Database Password (strong password)
POSTGRES_PASSWORD_PRODUCTION=CHANGE_ME_TO_A_STRONG_PASSWORD

# Redis Password
REDIS_PASSWORD_PRODUCTION=CHANGE_ME_TO_A_STRONG_PASSWORD

# RabbitMQ Password
RABBITMQ_PASSWORD_PRODUCTION=CHANGE_ME_TO_A_STRONG_PASSWORD
