# Node environment
NODE_ENV=production

# Server configuration
PORT=3000

# JWT secret – CHANGE THIS IN PRODUCTION
JWT_SECRET=your-secure-random-jwt-secret-here-minimum-32-chars

# Rate limiting
RATE_LIMIT_MAX=150

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Oracle Fusion credentials (set via UI or here for initial setup)
FUSION_BASE_URL=
FUSION_USERNAME=
FUSION_PASSWORD=

# Odoo configuration
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
ODOO_AUTH_TYPE=jsonrpc
ODOO_API_KEY=
ODOO_API_URL=
ODOO_VERSION=0
ODOO_TZ_OFFSET=0

# Odoo REST API custom paths (leave empty for defaults)
ODOO_SALE_DETAIL_PATH=
ODOO_ORDER_LINE_PATH=
ODOO_PAYMENT_PATH=
ODOO_POS_ORDER_PATH=

# Scheduler and automation
SCHEDULER_ENABLED=true

# Email notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=

# Webhook notifications
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_SUCCESS_ENABLED=false

# Application URL (for links in notifications)
APP_URL=http://localhost:3000
